{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "net.forwardemail/mcp-server",
  "title": "Forward Email",
  "description": "Privacy-focused email: domains, DNS verification, aliases, SMTP sending, mailboxes and calendars.",
  "websiteUrl": "https://forwardemail.net/en/blog/docs/mcp",
  "repository": {
    "url": "https://github.com/forwardemail/mcp-server",
    "source": "github"
  },
  "version": "1.0.7",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@forwardemail/mcp-server",
      "version": "1.0.7",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "FORWARD_EMAIL_API_KEY",
          "description": "API key from https://forwardemail.net/my-account/security",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "FORWARD_EMAIL_ALIAS_USER",
          "description": "Alias address for the mailbox, calendar and contact tools",
          "isRequired": false,
          "format": "string"
        },
        {
          "name": "FORWARD_EMAIL_ALIAS_PASSWORD",
          "description": "Generated password for that alias",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
